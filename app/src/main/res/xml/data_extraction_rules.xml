<?xml version="1.0" encoding="utf-8"?>
<!-- The database is only a cache of API responses, so there's no point in backing it up or
     moving it to a new device. Android 12+ uses these rules instead of allowBackup. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
